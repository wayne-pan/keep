# Runtime data
.git/
__pycache__/
*.pyc
*.pyo
learnings.jsonl

# Working-state (review/audit artifacts, not production)
.sprint/
.audit/
.keep/state/

# Benchmark data
codedb.snapshot

# Code intelligence index
.codedb/

# Local Claude config (personal permissions, paths)
# Exception: .claude/settings.json is team-shared (project-level hook
# registration for sprint-enforcement), so it IS tracked.
.claude/*
!.claude/settings.json

# Python cache
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Editor artifacts
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Secrets (never commit)
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
